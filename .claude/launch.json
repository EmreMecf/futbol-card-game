{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "futbol-kart-web",
      "runtimeExecutable": "flutter",
      "runtimeArgs": [
        "run",
        "-d",
        "web-server",
        "--web-port",
        "5580",
        "--web-hostname",
        "127.0.0.1"
      ],
      "port": 5580
    },
    {
      "name": "tasarim-referansi",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5590",
        "--bind",
        "127.0.0.1",
        "--directory",
        "design-reference"
      ],
      "port": 5590
    }
  ]
}