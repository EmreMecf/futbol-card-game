# =====================================================================
# BACKEND BAGLANTI AYARLARI
# =====================================================================
# Supabase birakildi. Uygulama artik kendi sunucumuza baglaniyor.
#
# ADRES SECERKEN DIKKAT:
#   Windows masaustu / web -> http://localhost:8080
#   Android emulator       -> http://10.0.2.2:8080
#                             (emulator icin 127.0.0.1 kendisidir!)
#   iOS simulator          -> http://localhost:8080
#   Gercek telefon         -> http://<bilgisayarinin-yerel-ip>:8080
#                             ornek: http://192.168.1.35:8080
#                             (telefon ve bilgisayar ayni wifi'da olmali)
# =====================================================================

# Su an masaustu/web icin ayarli. Android emulatorde test ederken
# bu satiri http://10.0.2.2:8080 olarak degistir.
API_BASE_URL=http://localhost:8080

# WebSocket adresi. Bos birakirsan API_BASE_URL'den otomatik turetilir
# (http -> ws, https -> wss).
WS_URL=

# Ag isteklerinin zaman asimi (saniye)
REQUEST_TIMEOUT_SECONDS=20

# Gelistirme sirasinda konsola log basilsin mi (true/false)
ENABLE_LOGGING=true
